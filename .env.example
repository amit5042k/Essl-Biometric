# Web server
PORT=3000
HOST=0.0.0.0
# SQLite database file (default: ./data/attendance.db)
# DB_PATH=./data/attendance.db

# First admin account (created on first start only)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_HOURS=12

# TCP/IP (pull) devices
POLL_MINUTES=5
AUTO_TIME_SYNC=true

# ADMS / Cloud (push) devices
# true = accept data from any new serial number immediately
ADMS_AUTO_APPROVE=false
# Server time zone sent to devices: hours (5.5) or minutes (330) for IST
ADMS_TIMEZONE=330
ADMS_DELAY=10
