# Time zone the machines' clocks use (IANA name). The server's own time zone
# is ignored, so this works on UTC servers too.
TIMEZONE=Asia/Kolkata

# Web server
PORT=3000
HOST=0.0.0.0
# SQLite database file (default: ./data/attendance.db)
# DB_PATH=./data/attendance.db

# First admin account (created on first start only)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_HOURS=12

# TCP/IP (pull) devices
POLL_MINUTES=5
AUTO_TIME_SYNC=true
# Correct a TCP/IP machine's clock on any sync where it is off by more than this many seconds
TIME_DRIFT_SECONDS=60

# ADMS / Cloud (push) devices
# true = accept data from any new serial number immediately
ADMS_AUTO_APPROVE=false
# Time zone offset sent to ADMS devices: hours (5.5) or minutes (330).
# Leave unset to derive it from TIMEZONE.
# ADMS_TIMEZONE=330
ADMS_DELAY=10
